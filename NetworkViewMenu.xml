<?xml version="1.0" encoding="UTF-8"?>
<mainMenu>
  <menuBar>
    <!-- 网络编辑器面板菜单栏：HouTools 顶层菜单，插在 Help 之前。
         注入写法参照 SideFXLabs 的 NetworkViewMenu.xml（同机制已在 H22 验证）。
         菜单结构改动需重启 Houdini；scriptCode 是薄分发器，工具代码照常热加载。 -->
    <subMenu id="houtools_network_view_menu">
      <modifyItem>
        <insertBefore>help_menu</insertBefore>
      </modifyItem>
      <label>HouTools</label>

      <!-- item id 用 houtools.networkview.* 独立前缀，避免与主菜单条目热键冲突 -->
      <scriptItem id="houtools.networkview.automation">
        <label>Automation</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("automation")
        ]]></scriptCode>
      </scriptItem>

      <scriptItem id="houtools.networkview.video_to_sequence">
        <label>Video to Sequence</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("video_to_sequence")
        ]]></scriptCode>
      </scriptItem>

      <scriptItem id="houtools.networkview.hdr_library">
        <label>Hdr Library</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("hdr_library")
        ]]></scriptCode>
      </scriptItem>

      <scriptItem id="houtools.networkview.recipe_library">
        <label>Recipe Library</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("recipe_library")
        ]]></scriptCode>
      </scriptItem>

      <!-- 粘贴为 Object Merge：id 必须是 pane.wsheet.* 前缀，
           热键符号才是 h.pane.wsheet.houtools_paste_as_object_merge（网络编辑器上下文），
           默认键位 Ctrl+Shift+V 由 python3.13libs/uiready.py 在会话启动时分配，
           主菜单 HouTools -> Paste Hotkey Settings 可修改 -->
      <scriptItem id="pane.wsheet.houtools_paste_as_object_merge">
        <label>Paste as Object Merge</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("paste_as_object_merge", **kwargs)
        ]]></scriptCode>
      </scriptItem>
    </subMenu>
  </menuBar>
</mainMenu>
