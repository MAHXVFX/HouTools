<?xml version="1.0" encoding="UTF-8"?>

<!--
    节点右键菜单（OPmenu.xml）。

    Houdini 沿 HOUDINI_PATH 搜索同名文件并与 $HH/OPmenu.xml 合并；包清单已把
    仓库根放进 HOUDINI_PATH。**菜单结构改动需重启 Houdini**（menurefresh 实测
    刷不出 OPmenu，2026-10 会话验证）；scriptCode 引用的工具模块代码仍走
    Reload 热加载（菜单每次点击时才 import 工具模块）。

    HouTools 自有条目统一约定：条目块以 <separatorItem/> 起头，与系统自带项
    隔开（官方文件同样把 separatorItem 与 context 条目相邻放置，悬空分割线由
    菜单系统自动收起）；标签尾部加 [HT] 后缀；标签一律英文/ASCII——H22 实测
    中文 <label> 条目行出现但文字不渲染（与顶栏菜单栏同款限制）。

    Open Cache Folder 条目：右键带输出路径参数的节点即显示——sopoutput
    （filecache::2.0 / rop geometry / fbx）、vm_picture（mantra）、picture
    （karma）、outputimage（USD Render，为空时回退 loppath 指向节点的 picture）。
    候选清单须与 open_cache_folder.py 的 _OUTPUT_PARMS 双处同步。

    Capture Viewport to Node 条目：所有节点可用——截当前 3D 视窗落
    $HIP/HouTools_cfg/captures/（路径转横线命名，"-" 转义为 "~"），
    背景图引用存 "$HIP/..." 变量形态并钉在节点旁跟随移动；节点上写
    ht_capture_image 标记并挂改名/删除跟随回调。Delete Viewport Capture
    条目：仅在带该标记的节点上显示，删除背景图条目、磁盘文件与标记。

    scriptCode 只写两行分发器，逻辑一律在 houtools/tools/ 与模块。
-->
<menuDocument>
    <menu>
        <separatorItem/>
        <scriptItem id="houtools_open_cache_folder">
            <label>Open Cache Folder [HT]</label>
            <context>
                <!-- 候选参数清单与 houtools/tools/open_cache_folder.py 的
                     _OUTPUT_PARMS 保持同步（参数名互不重叠，节点命中其一） -->
                <expression>kwargs.get("node") is not None and any(kwargs["node"].parm(n) is not None for n in ("sopoutput", "vm_picture", "picture", "outputimage"))</expression>
            </context>
            <scriptCode><![CDATA[import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("open_cache_folder", kwargs)
]]></scriptCode>
        </scriptItem>
        <scriptItem id="houtools_capture_viewport_embed">
            <label>Capture Viewport to Node [HT]</label>
            <context>
                <!-- 所有节点可用：截当前 3D 视窗，图落
                     $HIP/HouTools_cfg/captures/，背景图钉在节点旁并跟随 -->
                <expression>kwargs.get("node") is not None</expression>
            </context>
            <scriptCode><![CDATA[import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("capture_viewport_embed", kwargs)
]]></scriptCode>
        </scriptItem>
        <scriptItem id="houtools_delete_viewport_capture">
            <label>Delete Viewport Capture [HT]</label>
            <context>
                <!-- 仅在带截图标记的节点上显示；标记键名与
                     capture_viewport_embed.py 的 MARKER_KEY 双处同步 -->
                <expression>kwargs.get("node") is not None and kwargs["node"].userData("ht_capture_image") is not None</expression>
            </context>
            <scriptCode><![CDATA[import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("delete_viewport_capture", kwargs)
]]></scriptCode>
        </scriptItem>
    </menu>
</menuDocument>
