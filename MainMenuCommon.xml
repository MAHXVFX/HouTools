<?xml version="1.0" encoding="UTF-8"?>
<mainMenu>
  <menuBar>
    <subMenu id="houtools_tools_menu">
      <!-- 挂在 Help 菜单之前 -->
      <insertBefore>help_menu</insertBefore>
      <label>HouTools</label>

      <!-- 开发期热加载按钮：重载所有 houtools 模块 -->
      <scriptItem id="houtools.dev.reload">
        <label>Reload Modules (Dev)</label>
        <scriptCode><![CDATA[
import houtools.dev.reloader as _houtools_reloader
_houtools_reloader.reload_all()
        ]]></scriptCode>
      </scriptItem>

      <separatorItem/>

      <!-- 工具入口：scriptCode 只写两行薄分发器，
           工具逻辑改动通过 Reload 按钮热加载，无需重启 -->
      <scriptItem id="houtools.automation">
        <label>Automation</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("automation")
        ]]></scriptCode>
      </scriptItem>

      <scriptItem id="houtools.video_to_sequence">
        <label>Video to Sequence</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("video_to_sequence")
        ]]></scriptCode>
      </scriptItem>

      <scriptItem id="houtools.hdr_library">
        <label>Hdr Library</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("hdr_library")
        ]]></scriptCode>
      </scriptItem>

      <scriptItem id="houtools.recipe_library">
        <label>Recipe Library</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("recipe_library")
        ]]></scriptCode>
      </scriptItem>

      <separatorItem/>

      <!-- 快捷键设置:捕获式改键,写 settings/hotkeys.json,
           uiready 每次启动应用。
           (粘贴为 Object Merge 的菜单入口在 NetworkViewMenu.xml,
           其 scriptItem 注册热键符号 h.pane.wsheet.houtools_paste_as_object_merge) -->
      <scriptItem id="houtools.paste_hotkey_settings">
        <label>Paste Hotkey Settings</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("paste_hotkey_settings")
        ]]></scriptCode>
      </scriptItem>

      <separatorItem/>

      <!-- About 页面:默认浏览器打开 docs/index.html(离线单文件,零外部依赖) -->
      <scriptItem id="houtools.about">
        <label>About HouTools</label>
        <scriptCode><![CDATA[
import houtools.dev.dispatcher as _houtools_dispatcher
_houtools_dispatcher.run("about_houtools")
        ]]></scriptCode>
      </scriptItem>
    </subMenu>
  </menuBar>
</mainMenu>
